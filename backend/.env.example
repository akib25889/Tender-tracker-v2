# Database: SQLite for local dev, MySQL 8.4 for production
DATABASE_URL=sqlite:///./tender_tracker.db
# MySQL 8.4 Production Example:
# DATABASE_URL=mysql+pymysql://tender_user:strong_password@localhost:3306/tender_tracker

# Local SSD Storage Root
STORAGE_ROOT=./storage

# Security
SECRET_KEY=tendertracker-command-center-secret-key-2026-v2
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
