# TenderTracker Command Center Environment Configuration

# Database URLs (choose one)
# 1. SQLite (Default zero-config local dev):
# DATABASE_URL=sqlite:///./tender_tracker.db

# 2. PostgreSQL:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/tendertracker

# 3. MySQL 8.4:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/tendertracker

# JWT Authentication
SECRET_KEY=tendertracker-command-center-secret-key-2026-v2
ACCESS_TOKEN_EXPIRE_MINUTES=10080
