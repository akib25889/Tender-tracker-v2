[Unit]
Description=TenderTracker Command Center Backend API (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=tendertracker
Group=tendertracker
WorkingDirectory=/opt/tender-tracker/backend
EnvironmentFile=/opt/tender-tracker/backend/.env
ExecStart=/opt/tender-tracker/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 4

Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s

# Sandboxing & Security Hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
